{
  "name": "claude-session-explorer",
  "version": "0.3.0",
  "description": "Deterministic CLI for extracting structured data from Claude Code session history",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "cse": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:slop": "node_modules/@ast-grep/cli/ast-grep scan --error",
    "lint:arch": "depcruise src",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "verify": "pnpm typecheck && pnpm lint && pnpm lint:slop && pnpm lint:arch && pnpm test && pnpm knip && pnpm build",
    "prepare": "lefthook install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AugurCognito/claude-session-explorer.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@ast-grep/cli": "^0.44.1",
    "@biomejs/biome": "^2.4.4",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.0.0",
    "knip": "^6.24.0",
    "lefthook": "^2.1.9",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3"
  }
}
